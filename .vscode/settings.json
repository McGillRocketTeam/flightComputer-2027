{
    // clangd is the single IntelliSense engine for this project.
    // It reads compile_commands.json (generated by `pio run -t compiledb`),
    // so it sees the real build flags including `-I modules`.
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.codeAnalysis.runAutomatically": false,

    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--header-insertion=never",
        "--query-driver=${userHome}/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*"
    ],

    // PlatformIO drives the build; don't let it fight clangd over the index.
    "platformio-ide.autoRebuildAutocompleteIndex": true
}
